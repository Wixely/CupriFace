<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Android leg. Same portable half as the other two; the difference is that libGLESv3.so
       EXPORTS the GLES 3 entry points, so a plain DllImport binds them with no proc-address dance
       and no static-link trick. Three hosts, three ways of obtaining the address, one call shape.

       No SkiaSharp here on purpose: Android's own BitmapFactory decodes the embedded JPEG. That is
       the same boundary the other legs keep — the platform decodes, the renderer sees RGBA — and
       this leg is the cheapest proof that the boundary is real rather than a Skia convenience. -->

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <ApplicationId>com.cupriface.glprobe</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <IsPackable>false</IsPackable>
    <RootNamespace>CupriFace.Experiments.GlProbe.Android</RootNamespace>
    <!-- CoreCLR, matching what CupriFace.Android pins. Mono 10.0.11 has a codegen defect that
         crashes at startup (forensics in samples/AndroidProbe/MONO-CRASH.md); nothing here depends
         on the engine, but there is no reason to walk into a known-bad runtime. -->
    <UseMonoRuntime>false</UseMonoRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../shared/Gltf.cs" Link="Gltf.cs" />
    <!-- An Android asset, not an embedded resource: AssetManager is the platform's own way in, and
         using it keeps this leg free of anything the other two supply. -->
    <AndroidAsset Include="../assets/teapot.glb" Link="Assets/teapot.glb" />
  </ItemGroup>

</Project>
