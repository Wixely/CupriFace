{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/CupriFace.slnx",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run-web-blazor",
      "detail": "Serve the Blazor WASM host (samples/Web).",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/samples/Web/Web.csproj"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Now listening on:"
        }
      }
    },
    {
      "label": "run-web-raw",
      "detail": "Serve the raw .NET-WASM host (samples/WebWasm) — no Blazor.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/samples/WebWasm/WebWasm.csproj",
        "-c",
        "Release"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "App url:"
        }
      }
    },
    {
      "label": "serve-webwasm-debug",
      "detail": "Serve the raw .NET-WASM host (Debug, with symbols) for the browser debugger.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/samples/WebWasm/WebWasm.csproj"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "App url:"
        }
      }
    },
    {
      "label": "clean-webwasm",
      "detail": "Delete samples/WebWasm obj/bin/publish output. Run this if the WASM page ever shows an SRI 'integrity' error or a blank canvas after switching build modes.",
      "type": "shell",
      "windows": {
        "command": "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue '${workspaceFolder}/samples/WebWasm/obj','${workspaceFolder}/samples/WebWasm/bin','${workspaceFolder}/samples/WebWasm/publish-aot','${workspaceFolder}/samples/WebWasm/publish'"
      },
      "problemMatcher": []
    },
    {
      "label": "publish-webwasm-aot",
      "detail": "AOT-publish the raw .NET-WASM host (slow first build ~3-4 min; then incremental).",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/samples/WebWasm/WebWasm.csproj",
        "-c",
        "Release",
        "-p:Aot=true",
        "-o",
        "${workspaceFolder}/samples/WebWasm/publish-aot"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "serve-webwasm-aot",
      "detail": "Publish (AOT) then statically serve the output at http://127.0.0.1:5199.",
      "dependsOn": "publish-webwasm-aot",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/samples/WebWasm/tools/Serve",
        "--",
        "${workspaceFolder}/samples/WebWasm/publish-aot/wwwroot",
        "5199"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving",
          "endsPattern": "Serving"
        }
      }
    },
    {
      "label": "android-run",
      "detail": "Build AndroidViewer, install it on the first adb device (emulator or USB phone), and launch it. Needs `dotnet workload install android` and a running emulator or a connected device — check with `adb devices`.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/samples/AndroidViewer/AndroidViewer.csproj",
        "-f",
        "net10.0-android",
        "-t:Run",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "android-logcat",
      "detail": "Follow the app's log channel (tag `cupri`: first frame, view geometry, gate markers, Console output).",
      "type": "shell",
      "command": "adb logcat -s cupri:I",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "."
        }
      }
    },
    {
      "label": "android-run-with-logcat",
      "detail": "Deploy + launch AndroidViewer, then stream its logcat in a second terminal.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "android-run",
        "android-logcat"
      ],
      "problemMatcher": []
    },
    {
      "label": "publish-webllvm",
      "detail": "Publish the EXPERIMENTAL NativeAOT-LLVM web host (slow first build ~4-6 min; then incremental).",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/samples/WebLlvm/WebLlvm.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "serve-webllvm",
      "detail": "Publish (NativeAOT-LLVM) then statically serve the output at http://127.0.0.1:5230.",
      "dependsOn": "publish-webllvm",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/samples/WebWasm/tools/Serve",
        "--",
        "${workspaceFolder}/samples/WebLlvm/bin/Release/net10.0/browser-wasm/publish",
        "5230"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving",
          "endsPattern": "Serving"
        }
      }
    }
  ]
}
