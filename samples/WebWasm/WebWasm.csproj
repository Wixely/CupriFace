<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- This project is browser-only by definition; the JSExport/JSImport platform hints
         (CA1416 "only supported on browser") are expected and not actionable here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- SkiaSharp ships a static wasm lib that must be linked into the app. -->
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <!-- The portable engine + the SAME app the desktop Viewer and Blazor host run. -->
    <ProjectReference Include="..\..\src\CupriFace\CupriFace.csproj" />
    <ProjectReference Include="..\DemoApp\DemoApp.csproj" />
    <!-- Skia native for the browser (the desktop natives in the engine are ignored here). -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.116.1" />
  </ItemGroup>

</Project>
