<Project Sdk="Microsoft.NET.Sdk">

  <!-- The glue between CupriFace's GL seam and the Khalkos3D engine.

       ABOUT THIRTY LINES OF ACTUAL WORK, which is the point. CupriFace.Gl acquires a context bound
       to a page element on every host and hands over a proc-address function and a size;
       Khalkos3D.GlRenderer wants exactly a proc-address function and a size. Neither library knows
       the other exists, and neither had to change.

       WHY IT LIVES HERE RATHER THAN IN KHALKOS3D. A general-purpose engine taking a dependency on a
       UI toolkit inverts the direction. CupriFace is the consumer, so CupriFace holds the adapter.

       THE SUBMODULE IS GONE. Khalkos3D was referenced by project through external/Khalkos3D while
       the GLES and WebGL2 paths were unproven, so that a failure could be stepped into rather than
       diagnosed by publishing another package to find out. Both are proved — on a real GLES driver
       through the Android device gate and on WebGL2 through the browser gate — so it is a package. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CupriFace.Gl\CupriFace.Gl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine, as a package. It was a submodule while the GLES and WebGL2 paths were being
         proved on real drivers, because a failure you can step into beats one you diagnose by
         publishing another package to find out. They are proved now, so this is a version number.

         Restoring these needs a token even though the packages are public — see NuGet.config. -->
    <PackageReference Include="Khalkos3D.Core" Version="0.2.2" />
    <PackageReference Include="Khalkos3D.Formats" Version="0.2.2" />
    <PackageReference Include="Khalkos3D.Gl" Version="0.2.2" />

    <!-- Khalkos3D bundles no image codec on purpose, so a caller supplies one. A CupriFace app
         already has Skia, which is the whole argument for the seam being a delegate. -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same model the hand-written sample renderer uses, so the two are comparable. -->
    <EmbeddedResource Include="..\Demo3d\teapot.glb" LogicalName="teapot.glb" />
  </ItemGroup>

</Project>
