<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\src\CupriCodecNatives.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The 3D demo surface issues raw GL through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CupriFace.Samples.Viewer</RootNamespace>
    <!-- NativeAOT publish, opt-in: `dotnet publish -c Release -r win-x64 -p:Aot=true`.
         Gated behind an explicit property (the same convention as WebWasm's wasm AOT) so ordinary
         builds never need the C++ toolchain — and so the flag lands HERE rather than flowing to the
         netstandard2.0 source generators, which cannot be AOT'd (NETSDK1207).
         Re-measured 2026-09 (win-x64, this Showcase app): 25.1 MB self-contained — a 12.3 MB exe
         plus 12.7 MB of Skia/HarfBuzz/SDL/GLFW natives, in 5 files rather than one.
         This build used to lose BOTH hardware GL and the UIA bridge, silently (#126): the GL half
         is the same Silk.NET reflection problem trimming has, and the roots below now apply here
         too; the UIA half was the runtime's built-in COM interop, which NativeAOT does not have at
         all, and the bridge now goes through source-generated COM instead. Either regression would
         show as a software window or a missing accessibility tree with the app otherwise fine, so
         a figure measured on an AOT build should say which path it took. -->
    <PublishAot Condition="'$(Aot)' == 'true'">true</PublishAot>
    <InvariantGlobalization Condition="'$(Aot)' == 'true'">true</InvariantGlobalization>

    <!-- Trimmed + compressed single-file publish, opt-in. Add these to the existing release
         publish command (which already passes the RID, self-contained and PublishSingleFile):
             -p:Trim=true -p:EnableCompressionInSingleFile=true
         Scoped to a property for the SAME reason PublishAot is: on the command line it flows to
         the netstandard2.0 source generators and fails there (NETSDK1124).

         Measured 2026-09 (win-x64, this Showcase app): the untrimmed single file is 95.4 MB;
         trimming alone takes it to 33.8 MB and trimming + compression to 20.8 MB. Extraction on
         disk drops 85.5 MB -> 24.8 MB, first launch (cold extract) is ~150 ms and later launches
         ~97 ms, so the compression costs nothing noticeable.

         Two things break under trimming unless the properties below come with it, and BOTH fail
         silently — the app still opens a window and draws, so a smoke test that only checks
         "did it render" passes while the build is materially worse:
           - hardware GL (falls back to the SDL software window), fixed by the TrimmerRootAssembly
             items below;
           - the UIA accessibility bridge, fixed by moving it to source-generated COM.
         Verified with tests/UiaSmoke against the trimmed exe: identical to the untrimmed build
         (50 elements, 44 from CupriFace, same passes). -->
    <PublishTrimmed Condition="'$(Trim)' == 'true'">true</PublishTrimmed>

    <!-- No BuiltInComInteropSupport here any more, on purpose. The UIA bridge used to need the
         runtime's built-in COM interop, which the SDK switches off for trimmed apps and NativeAOT
         lacks outright; it now goes through source-generated COM (UiaInterop.cs), which is plain
         compiled code and needs no runtime feature switched on. tests/UiaSmoke against the
         trimmed exe is the proof, and it runs in CI on every build. -->

    <!-- REQUIRED whenever this app is published with PublishSingleFile.
         Silk.NET finds SDL2/GLFW through DependencyContext and Assembly.Location, and BOTH are dead
         inside a single-file bundle (DependencyContext returns null, Location returns ""). With only
         IncludeNativeLibrariesForSelfExtract the exe builds happily and then dies at startup with
         "Could not load from any of the possible library names!" the moment it opens a window.
         IncludeAllContentForSelfExtract extracts the whole app to disk first, so those two APIs work
         again. Costs a one-off ~6 s extraction on the very first launch; later runs are ~1.5 s. -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!-- Silk.NET 2.x discovers its window/input backends by scanning for IWindowPlatform
       implementations, so the trimmer removes them (IL2104) and bring-up fails with
       PlatformNotSupportedException — which DesktopHost catches, silently dropping to the SDL
       software window. Rooting the backend assemblies keeps those reflection targets alive; the
       cost is ~0.13 MB. NativeAOT trims the same way and lost the same backends, so the roots
       apply to it too. -->
  <ItemGroup Condition="'$(Trim)' == 'true' Or '$(Aot)' == 'true'">
    <TrimmerRootAssembly Include="Silk.NET.Windowing.Glfw" />
    <TrimmerRootAssembly Include="Silk.NET.Input.Glfw" />
    <TrimmerRootAssembly Include="Silk.NET.GLFW" />
    <TrimmerRootAssembly Include="Silk.NET.Windowing.Common" />
    <TrimmerRootAssembly Include="Silk.NET.Input.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CupriFace.Shell\CupriFace.Shell.csproj" />
    <ProjectReference Include="..\..\src\CupriFace.Media\CupriFace.Media.csproj" />
    <ProjectReference Include="..\DemoApp\DemoApp.csproj" />
    <!-- The 3D demo's renderer. Referenced HERE and not by DemoApp, for the same reason video is
         wired here: the shared ShowcaseApp is compiled by the wasm and Android hosts too. -->
    <ProjectReference Include="..\Khalkos3dBridge\Khalkos3dBridge.csproj" />
    <!-- Kept: the hand-written renderer the engine was measured against. Switching back is
         one type name in Teapot3dSurface. -->
    <ProjectReference Include="..\Demo3d\Demo3d.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev convenience: codec natives dropped into native/<rid>/ (codecs.yml artifacts) ride
         along when running from source, laid out per-RID (src/CupriCodecNatives.props) — with
         six RIDs a flat copy can't work, three pairs share a filename. CodecLibraryResolver
         loads the running one. Packaged consumers get them from the nupkg's runtimes/. -->
    <None Include="@(CupriCodecNative)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
