<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CupriFace.Samples.Viewer</RootNamespace>
    <!-- NativeAOT publish, opt-in: `dotnet publish -c Release -r win-x64 -p:Aot=true`.
         Gated behind an explicit property (the same convention as WebWasm's wasm AOT) so ordinary
         builds never need the C++ toolchain — and so the flag lands HERE rather than flowing to the
         netstandard2.0 source generators, which cannot be AOT'd (NETSDK1207).
         Measured 2026-08 (win-x64, this Showcase app): 23.3 MB self-contained — a 10.6 MB exe plus
         12.7 MB of Skia/HarfBuzz/SDL/GLFW natives — with a ~56 MB working set and ~310 ms to the
         first window. -->
    <PublishAot Condition="'$(Aot)' == 'true'">true</PublishAot>
    <InvariantGlobalization Condition="'$(Aot)' == 'true'">true</InvariantGlobalization>

    <!-- REQUIRED whenever this app is published with PublishSingleFile.
         Silk.NET finds SDL2/GLFW through DependencyContext and Assembly.Location, and BOTH are dead
         inside a single-file bundle (DependencyContext returns null, Location returns ""). With only
         IncludeNativeLibrariesForSelfExtract the exe builds happily and then dies at startup with
         "Could not load from any of the possible library names!" the moment it opens a window.
         IncludeAllContentForSelfExtract extracts the whole app to disk first, so those two APIs work
         again. Costs a one-off ~6 s extraction on the very first launch; later runs are ~1.5 s. -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CupriFace.Shell\CupriFace.Shell.csproj" />
    <ProjectReference Include="..\..\src\CupriFace.Media\CupriFace.Media.csproj" />
    <ProjectReference Include="..\DemoApp\DemoApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev convenience: codec natives dropped into native/<rid>/ (codecs.yml artifacts) ride
         along when running from source. Packaged consumers get them from the nupkg's runtimes/. -->
    <None Include="..\..\native\win-x64\cupricodecs.dll" CopyToOutputDirectory="PreserveNewest"
          Visible="false" Condition="Exists('..\..\native\win-x64\cupricodecs.dll')" />
    <None Include="..\..\native\linux-x64\libcupricodecs.so" CopyToOutputDirectory="PreserveNewest"
          Visible="false" Condition="Exists('..\..\native\linux-x64\libcupricodecs.so')" />
    <None Include="..\..\native\osx-arm64\libcupricodecs.dylib" CopyToOutputDirectory="PreserveNewest"
          Visible="false" Condition="Exists('..\..\native\osx-arm64\libcupricodecs.dylib')" />
  </ItemGroup>

</Project>
