<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CupriFace.Demo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Portable app: references only the engine (no windowing, no platform code). -->
    <ProjectReference Include="..\..\src\CupriFace\CupriFace.csproj" />
    <!-- AOT-clean binding accessors for this project's [CupriBindable] models. -->
    <ProjectReference Include="..\..\src\CupriFace.Binding.Gen\CupriFace.Binding.Gen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Typed accessors for the embedded Assets/ files (emits the `Assets` class). -->
    <ProjectReference Include="..\..\src\CupriFace.Resources.Gen\CupriFace.Resources.Gen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Embed Assets/*.html|css (and future media) at compile time + feed the generator. -->
  <Import Project="..\..\src\CupriFace.Resources.targets" />

</Project>
