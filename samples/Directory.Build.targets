<Project>
  <!--
    What a NuGet consumer of CupriFace.Shell gets from its buildTransitive targets, applied to every
    sample here, because a ProjectReference does not carry buildTransitive: the dev tools switch
    (F12 inspector, hot reload, doctor on save) on in Debug and off in every other configuration.
    Harmless for a sample that never opens a desktop window — only DesktopHost reads the switch.
  -->
  <Import Project="..\src\CupriFace.Shell\buildTransitive\CupriFace.Shell.targets" />
</Project>
