<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Showcase's 3D demo, split so it can be referenced by every host.

       DELIBERATELY HAS NO HOST DEPENDENCY. It is GL calls through a function-pointer table plus a
       GLB reader — no windowing, no Skia, no engine. That is what lets the identical code compile
       for desktop (net10.0), Android and browser-wasm, where a Silk.NET or SkiaSharp reference in
       here would break the wasm leg. Each host's composition root owns the ~100 lines that acquire
       a GL context and publish frames, because THAT is the part that genuinely differs.

       It is a sample, not a product: CupriFace does not ship a 3D renderer, and this exists to
       demonstrate the surface seam rather than to be copied as an engine. See samples/Demo3d/README.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CupriFace.Demo.ThreeD</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The seam, so this project can express itself as IGlContent and stop caring which host it is
         on. It is host-AGNOSTIC, not host-coupled: CupriFace.Gl references no host assembly, which
         is precisely what lets one renderer compile for desktop, Android and browser-wasm alike.
         SkiaSharp arrives with it and is used for exactly one thing — decoding a PNG to RGBA. -->
    <ProjectReference Include="..\..\src\CupriFace.Gl\CupriFace.Gl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied: the wasm and Android hosts have no working directory to read
         from, and an embedded asset resolves identically on all four. -->
    <EmbeddedResource Include="teapot.glb" />
  </ItemGroup>

</Project>
