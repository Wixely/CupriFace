<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear first: this project must resolve CupriFace.Android from the freshly packed feed
         beside it and nothing else, on any machine, whatever the developer has configured
         globally. Everything the package depends on (SkiaSharp, HarfBuzzSharp) comes from
         nuget.org publicly. -->
    <clear />
    <add key="cupriface-local" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
