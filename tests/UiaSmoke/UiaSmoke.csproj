<Project Sdk="Microsoft.NET.Sdk">

  <!-- The UIA gate: launches a published Viewer and interrogates it as a REAL UIA client
       (FlaUI), the same channel Narrator/NVDA use. Deliberately NOT in the solution: FlaUI is
       Windows-only (net10.0-windows), and the solution restores/builds on Linux and macOS in CI.
       Run it with `dotnet run` from this folder, passing the path to a Viewer.exe as the single
       argument. CI runs it as a blocking step on the win-x64 Viewer job. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- FlaUI's transitive System.Drawing.Common 5.x has a known vulnerability (NU1904);
         reference a patched line directly. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>
