<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>CupriFace.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CupriFace\CupriFace.csproj" />
    <ProjectReference Include="..\..\src\CupriFace.Media\CupriFace.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real font files for the registration tests, copied beside the test binary so the tests are
         machine-independent and run anywhere (including CI). -->
    <None Include="..\..\samples\WebWasm\Assets\fonts\*.ttf" LinkBase="fonts"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The demo clip (browser-recorded VP9 WebM) doubles as the demuxer's fixture — copied for
         file-path tests AND embedded for the embedded-source resolution test. -->
    <None Include="..\..\samples\DemoApp\Assets\demo.webm" LinkBase="fixtures"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The A/V clip (VP9 + Opus): the audio-track cases the video-only fixture can't cover. -->
    <None Include="..\..\samples\DemoApp\Assets\demo-av.webm" LinkBase="fixtures"
          CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\samples\DemoApp\Assets\demo.webm" LogicalName="fixtures.demo.webm" />
    <!-- Codec natives when present (codecs.yml artifacts dropped into native/<rid>/): the
         NativeDecodeTests then exercise the real libvpx/libopus binding instead of skipping. -->
    <None Include="..\..\native\win-x64\cupricodecs.dll" CopyToOutputDirectory="PreserveNewest"
          Visible="false" Condition="Exists('..\..\native\win-x64\cupricodecs.dll')" />
    <None Include="..\..\native\linux-x64\libcupricodecs.so" CopyToOutputDirectory="PreserveNewest"
          Visible="false" Condition="Exists('..\..\native\linux-x64\libcupricodecs.so')" />
  </ItemGroup>

  <!-- Native Skia + HarfBuzz so RenderToImage/decode run under `dotnet test`. -->
  <Import Project="..\..\src\SkiaNativeAssets.props" />

</Project>
