<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>CupriFace.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CupriFace\CupriFace.csproj" />
    <ProjectReference Include="..\..\src\CupriFace.Media\CupriFace.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real font files for the registration tests, copied beside the test binary so the tests are
         machine-independent and run anywhere (including CI). -->
    <None Include="..\..\samples\WebWasm\Assets\fonts\*.ttf" LinkBase="fonts"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The demo clip (browser-recorded VP9 WebM) doubles as the demuxer's fixture. -->
    <None Include="..\..\samples\DemoApp\Assets\demo.webm" LinkBase="fixtures"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Native Skia + HarfBuzz so RenderToImage/decode run under `dotnet test`. -->
  <Import Project="..\..\src\SkiaNativeAssets.props" />

</Project>
