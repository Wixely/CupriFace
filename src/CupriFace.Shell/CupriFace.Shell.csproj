<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine, so DesktopHost can run a CupriApp / CupriDocument. -->
    <ProjectReference Include="..\CupriFace\CupriFace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Layer 0 (Shell): windowing + input + GL context -->
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.22.0" />
    <!-- Layer 4 (Paint): Skia rendering (managed; native binaries via the import below) -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <!-- Portable native Skia + HarfBuzz for win/linux/osx (shared with the engine). -->
  <Import Project="..\SkiaNativeAssets.props" />

</Project>
