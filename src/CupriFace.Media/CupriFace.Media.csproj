<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\CupriCodecNatives.props" />

  <!-- The optional media package: WebM playback for <cupri-video> on desktop hosts.
       Managed demux (pure C# EBML/Matroska parser) + native DECODERS ONLY (libvpx for VP9,
       libopus for audio), shipped per-RID inside THIS one package under runtimes/<rid>/native —
       the Skia model: one PackageReference, every OS, a framework-dependent app built on
       Windows runs on Linux via `dotnet` unchanged. The engine itself never references this;
       hosts attach it at their composition root (DesktopHost.Run's configure hook). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The YUV→RGBA loop and the codec P/Invoke layer use raw pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>WebM (VP9 + Opus) video playback for CupriFace's cupri-video element on desktop hosts. Managed demuxer; per-RID native decoders in one package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CupriFace/CupriFace.csproj" />
    <!-- Audio out rides the same managed SDL binding the desktop shell ships - no new natives. -->
    <PackageReference Include="Silk.NET.SDL" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The per-RID codec natives (codecs.yml artifacts, one list in CupriCodecNatives.props;
         each item carries its own runtimes/<rid>/native PackagePath). CI drops them into
         native/<rid>/ before packing; files that aren't there are simply not packed. -->
    <None Include="@(CupriCodecNative)" Pack="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The player's pump is driven directly (manual clock) by the headless tests. -->
    <InternalsVisibleTo Include="CupriFace.Tests" />
  </ItemGroup>

</Project>
