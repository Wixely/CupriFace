<Project>
  <!--
    The codec natives, one list, two consumers: CupriFace.Media packs them into
    runtimes/<rid>/native (each item carries its own PackagePath) and MediaProbe copies them
    beside the app so a single build runs on any desktop OS. Built by .github/workflows/codecs.yml
    into native/<rid>/ — files that aren't there are simply skipped, so a source build without
    them still compiles and NativeDecoders.Available reports false at runtime.

    Adding a RID means: a build job in codecs.yml, a runnable leg in its portability gate, one
    line here, and the fetch list in ci.yml's release job. Nothing else.
  -->
  <PropertyGroup>
    <CupriNativeDir>$(MSBuildThisFileDirectory)..\native\</CupriNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <CupriCodecNative Include="$(CupriNativeDir)win-x64\cupricodecs.dll"
                      PackagePath="runtimes/win-x64/native" Visible="false"
                      Condition="Exists('$(CupriNativeDir)win-x64\cupricodecs.dll')" />
    <CupriCodecNative Include="$(CupriNativeDir)win-arm64\cupricodecs.dll"
                      PackagePath="runtimes/win-arm64/native" Visible="false"
                      Condition="Exists('$(CupriNativeDir)win-arm64\cupricodecs.dll')" />
    <CupriCodecNative Include="$(CupriNativeDir)linux-x64\libcupricodecs.so"
                      PackagePath="runtimes/linux-x64/native" Visible="false"
                      Condition="Exists('$(CupriNativeDir)linux-x64\libcupricodecs.so')" />
    <CupriCodecNative Include="$(CupriNativeDir)linux-arm64\libcupricodecs.so"
                      PackagePath="runtimes/linux-arm64/native" Visible="false"
                      Condition="Exists('$(CupriNativeDir)linux-arm64\libcupricodecs.so')" />
    <CupriCodecNative Include="$(CupriNativeDir)osx-x64\libcupricodecs.dylib"
                      PackagePath="runtimes/osx-x64/native" Visible="false"
                      Condition="Exists('$(CupriNativeDir)osx-x64\libcupricodecs.dylib')" />
    <CupriCodecNative Include="$(CupriNativeDir)osx-arm64\libcupricodecs.dylib"
                      PackagePath="runtimes/osx-arm64/native" Visible="false"
                      Condition="Exists('$(CupriNativeDir)osx-arm64\libcupricodecs.dylib')" />
  </ItemGroup>
</Project>
