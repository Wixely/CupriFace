<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CupriFace</RootNamespace>
    <!-- For one signature: the SkiaSharp overload Paint/ShaderRegistry.cs reaches takes an SKMatrix*. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Renders HTML + CSS to a Skia canvas and binds it to plain C# objects — a UI engine with no browser, no JavaScript engine and no XAML. Lays out (flexbox/grid), shapes text with HarfBuzz, paints with Skia, and renders into any canvas or RGBA buffer, so it also runs headless.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source generator: reflection-free binding accessors (AOT-clean) -->
    <ProjectReference Include="..\CupriFace.Binding.Gen\CupriFace.Binding.Gen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time binding checks (CF0060): every {{Path}} in an app's markup against its model.
         Run over the engine too — anything here that binds markup to a model gets checked. -->
    <ProjectReference Include="..\CupriFace.Binding.Analyzers\CupriFace.Binding.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Build order only: the Assets generator is packed below, so it must exist before pack runs.
         It is not an analyzer of the engine itself, which has no Assets/ folder. -->
    <ProjectReference Include="..\CupriFace.Resources.Gen\CupriFace.Resources.Gen.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the generators and the analyzer INSIDE this package, so a consumer installing CupriFace
         from NuGet gets the AOT-clean binding accessors, the typed Assets class and the build-time
         binding checks automatically, exactly as projects in this repo do.
         (A ProjectReference is a build-time edge only — it does not travel in the .nupkg.) -->
    <None Include="../CupriFace.Binding.Gen/bin/$(Configuration)/netstandard2.0/CupriFace.Binding.Gen.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../CupriFace.Binding.Analyzers/bin/$(Configuration)/netstandard2.0/CupriFace.Binding.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../CupriFace.Resources.Gen/bin/$(Configuration)/netstandard2.0/CupriFace.Resources.Gen.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- The Assets pipeline that feeds them: Assets/** embedded under stable names and handed to the
         compiler as AdditionalFiles. In this repo projects import CupriFace.Resources.targets
         directly, because buildTransitive does not cross a ProjectReference edge. -->
    <None Include="buildTransitive\CupriFace.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="..\CupriFace.Resources.targets" Pack="true" PackagePath="buildTransitive\" Visible="false" />
  </ItemGroup>

  <!-- Portable native Skia + HarfBuzz for win/linux/osx (shared with the shell). -->
  <Import Project="..\SkiaNativeAssets.props" />

  <ItemGroup>
    <!-- Layer 1: HTML DOM + CSS selector engine (pure managed) -->
    <PackageReference Include="AngleSharp" Version="1.7.0" />
    <!-- Layer 4: paint + text shaping (managed; native binaries via the import above) -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.116.1" />
  </ItemGroup>

</Project>
