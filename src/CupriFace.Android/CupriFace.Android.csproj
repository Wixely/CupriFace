<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Android host: the mobile sibling of CupriFace.Shell. An app author writes a subclass of
    CupriActivity naming their CupriApp; this package supplies the surface, the input, the
    lifecycle, and (in later phases) the IME and the TalkBack bridge.

    Same layering law as the desktop shell: the ENGINE has no idea Android exists. Everything
    Android lives here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <Description>Android host for CupriFace: run a CupriApp as a native Android app (GPU-rendered via GL ES, no MAUI, no WebView). Requires CoreCLR (UseMonoRuntime=false) — see the package notes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CupriFace\CupriFace.csproj" />
    <!-- SKGLSurfaceView — a GLSurfaceView with a GRContext on its EGL context, the same
         GPU-surface model the desktop GL window uses. Keep versions in sync with the engine's
         SkiaSharp (src/SkiaNativeAssets.props documents the pins). -->
    <PackageReference Include="SkiaSharp.Views" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.116.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Android" Version="8.3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reaches nupkg CONSUMERS only (repo-internal apps set UseMonoRuntime in their csproj). -->
    <None Include="buildTransitive\CupriFace.Android.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
