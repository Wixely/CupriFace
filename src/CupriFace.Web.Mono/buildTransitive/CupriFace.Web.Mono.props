<Project>
  <!-- THE STATIC WEB ASSETS THIS PACKAGE CARRIES REACH A CONSUMER THROUGH HERE, AND ONLY HERE.
       The SDK normally generates this file to make this one import; we suppress that generation in
       the csproj so that this file survives packing at all (#216), which makes the import ours to
       make. Delete it and the package's wwwroot stops flowing, with no error to say so. The chain
       continues into files the SDK still generates: buildMultiTargeting\ imports build\, which
       imports the two Microsoft.AspNetCore props.

       GUARDED BECAUSE THIS FILE HAS TWO READERS. buildMultiTargeting\ is generated at PACK time and
       does not exist in this tree, while samples/WebWasm and friends import this file straight from
       source — deliberately, so that a sample exercises what a consumer receives. Unconditional,
       the import is MSB4019 for every one of them. Exists() against
       $(MSBuildThisFileDirectory) rather than a bare relative path: a bare one would be resolved
       against the CONSUMING project's directory, so it would be false in the package too, and this
       would silently become the empty import the issue was about. -->
  <Import Project="$(MSBuildThisFileDirectory)..\buildMultiTargeting\CupriFace.Web.Mono.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\buildMultiTargeting\CupriFace.Web.Mono.props')" />

  <!--
    Flows into apps that consume the CupriFace.Web NUPKG (repo-internal apps set the same
    properties in their own csproj — buildTransitive does not cross ProjectReference edges).

    Everything here is load-bearing rather than advisory, and every item is something an app
    author previously had to copy out of samples/WebWasm and then own forever (#73).
  -->
  <PropertyGroup>
    <!-- SkiaSharp ships a STATIC wasm library that has to be linked into the app. Without this the
         build succeeds and the app dies at runtime with unresolved Skia symbols. -->
    <WasmBuildNative Condition="'$(WasmBuildNative)' == ''">true</WasmBuildNative>

    <!-- The host's own JSExport/JSImport surface is browser-only by construction; an app that
         never writes a line of interop should not inherit CA1416 noise from it. Only defaulted,
         so an app that wants the analyzer back can set it. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
