<Project Sdk="Microsoft.NET.Sdk">

  <!-- The optional Lottie package: <cupri-lottie> playing After Effects JSON.

       Optional for the same reason CupriFace.Media is, but at a very different price. Media ships
       six hand-built native codec libraries because nothing in Skia decodes VP9. Lottie is already
       IN Skia — Skottie is a Skia module, and SkiaSharp publishes it as managed bindings over the
       SAME libSkiaSharp the engine already loads. So this package adds roughly 65 KB of managed
       assemblies and NOT ONE BYTE of native code: no per-RID builds, no CI matrix, nothing to sign.

       It is still opt-in rather than core, because most apps do not play Lottie and the engine's
       promise is that you pay for what you use. Add the PackageReference and call UseLottie(). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Lottie (After Effects JSON) animation playback for CupriFace via the cupri-lottie element. Renders through Skia's own Skottie module — managed only, no additional native assets.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CupriFace/CupriFace.csproj" />
    <!-- Skottie and its two companions are MIT, and P/Invoke into libSkiaSharp — the native library
         SkiaSharp already brings. Pinned to the engine's own SkiaSharp version: the managed bindings
         and the native library are a matched pair, and a mismatch is a runtime symbol failure rather
         than a build error. -->
    <PackageReference Include="SkiaSharp.Skottie" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CupriFace.Tests" />
  </ItemGroup>

</Project>
