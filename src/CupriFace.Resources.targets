<Project>

  <!--
    CupriFace resource pipeline. Ships in the CupriFace package (buildTransitive), so an app that
    installs it from NuGet gets this with nothing to write. Inside this repository, where a
    ProjectReference does not carry buildTransitive, import it into an app project instead:

        <Import Project="..\..\src\CupriFace.Resources.targets" />

    Author markup / styles / media as real files under an "Assets" folder (editable in the IDE with
    normal HTML/CSS tooling). At build they are:
      * embedded into the assembly manifest under a STABLE logical name ("Assets/<relative/path>"),
        so CupriSource.Embedded(...) resolves the same on desktop and WASM; and
      * surfaced to the CupriFace.Resources.Gen source generator and the build-time binding check
        (CF0060) via AdditionalFiles + the CupriLogicalName metadata, so the generator can emit the
        typed `Assets` accessor class and the check can find the markup a model is bound to.
  -->

  <PropertyGroup>
    <!-- Read by the packaged buildTransitive/CupriFace.targets: a project that imported this file
         itself must not have every asset embedded a second time by the package. -->
    <_CupriFaceResourcesImported>true</_CupriFaceResourcesImported>
  </PropertyGroup>

  <ItemGroup>
    <CupriAsset Include="$(MSBuildProjectDirectory)\Assets\**\*" />

    <!-- Don't also carry them as loose content. -->
    <None Remove="$(MSBuildProjectDirectory)\Assets\**\*" />

    <!-- Embed with a forward-slashed, RootNamespace-independent logical name. The Exclude makes a
         second copy of this pipeline (a hand-copied, older targets file alongside the package's) a
         no-op rather than a duplicate-resource error. -->
    <EmbeddedResource Include="@(CupriAsset)" Exclude="@(EmbeddedResource)">
      <LogicalName>Assets/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- Hand the same files (and their logical name) to the source generator and the analyzer. -->
    <AdditionalFiles Include="@(CupriAsset)" Exclude="@(AdditionalFiles)">
      <CupriLogicalName>Assets/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</CupriLogicalName>
    </AdditionalFiles>
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="CupriLogicalName" />
  </ItemGroup>

  <!--
    Hot reload (CupriFace.DevTools): where these assets live on disk, so a running Debug build can
    watch Assets/App.html and read the saved file instead of the copy compiled in. Only when the dev
    tools are on — a Debug build, unless CupriDevTools says otherwise — so a Release binary carries no
    path from the machine that built it.
  -->
  <ItemGroup Condition="'$(CupriDevTools)' == 'true' Or ('$(CupriDevTools)' == '' And '$(Configuration)' == 'Debug')">
    <AssemblyMetadata Include="CupriFace.AssetsRoot" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

</Project>
