<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately outside src/ and outside the solution: this is a throwaway question-answerer,
       not a shipped component. It exists to find out whether the macOS accessibility bridge can be
       written in pure C# before anyone writes one. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
